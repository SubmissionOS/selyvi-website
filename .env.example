# Vorlage für .env.local – diese Datei enthält KEINE echten Werte.
# .env.local ist über .gitignore ausgeschlossen und gehört nie ins Repository.
#
# Keine dieser Variablen trägt ein NEXT_PUBLIC_-Präfix. Nur so präfixierte
# Variablen werden von Next.js in das Browser-Bundle eingesetzt – diese hier
# bleiben serverseitig.

# Brevo-API-Schlüssel für den Versand der Demo-Anfragen.
# Wird ausschließlich in src/lib/demo/brevo.ts gelesen.
# NIEMALS mit NEXT_PUBLIC_ präfixieren.
BREVO_API_KEY=

# Zieladresse der Demo-Anfragen.
# [PRÜFEN] Zieladresse vom Team – Postfach oder CRM-Inbound folgt.
DEMO_MAIL_TO=

# Absenderadresse. Muss auf einer in Brevo verifizierten Domain liegen.
# [PRÜFEN] Verifizierte Brevo-Absender-Domain erst nach Domainkauf möglich –
# bis dahin Testmodus über DEMO_DRY_RUN.
DEMO_MAIL_FROM=

# NUR FÜR DIE ENTWICKLUNG: überspringt den echten Versand und schreibt die
# Anfrage stattdessen ins Server-Log. Das Formular meldet Erfolg, OBWOHL keine
# E-Mail verschickt wurde.
# In Produktion niemals auf true setzen.
DEMO_DRY_RUN=false
