# Sicherheitsvorgaben des Projekts.
# ignore-scripts: keine pre/post-install-Hooks aus Abhaengigkeiten ausfuehren.
#   Nahezu alle npm-Supply-Chain-Angriffe der letzten Jahre (Shai-Hulud, keyv,
#   node-gyp/binding.gyp, React-Native-Kampagne) liefern ihre Payload ueber
#   genau diese Hooks aus.
ignore-scripts=true

# save-exact: Versionen immer exakt pinnen, keine ^/~-Ranges.
save-exact=true
